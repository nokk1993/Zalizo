    "Без подвоєння: Health сам об'єднує записи з обох пристроїв.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No double counting: Health merges records from both devices."
          }
        }
      }
    },
    "Без серверів, акаунтів, аналітики й реклами.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No servers, accounts, analytics or ads."
          }
        }
      }
    },
